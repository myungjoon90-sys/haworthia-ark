<%
  // ---- 표시용 데이터 정리 ----
  const v = (x) => String(x === undefined || x === null ? '' : x).trim();
  const 품종명 = v(plant['품종명']);
  const 고유번호 = v(plant['고유번호']);
  const 육종가 = v(plant['육종가']);
  const 육종연도 = v(plant['육종연도']);
  const 모본 = v(plant['모본']);
  const 부본 = v(plant['부본']);
  const 마커 = v(plant['DNA마커']);
  const 사진 = v(plant['사진URL']);
  const 소유자 = v(plant['소유자']);
  const 발급일 = v(plant['발급일']);
  const 상태 = v(plant['상태']) || '미인증';
  const 교배 = (모본 && 부본) ? (모본 + ' × ' + 부본) : (모본 || 부본);
  const 메시지 = v(plant['관리자메시지']) ||
    '한 점 한 점 정성으로 길러낸 귀한 하월시아입니다. 살아있는 보석을 소장해 주셔서 진심으로 감사드립니다. 오래도록 아름답게 함께하시길 바랍니다.';
  const 이력 = v(plant['소유이력']).split(/\r?\n/).map((line) => {
    const t = line.trim();
    if (!t) return null;
    const idx = t.indexOf('|');
    if (idx === -1) return { when: '', who: t };
    return { when: t.slice(0, idx).trim(), who: t.slice(idx + 1).trim() };
  }).filter(Boolean);
  // 등급별 표기
  const gradeKey = (typeof grade !== 'undefined' && grade) ? grade : '기본';
  const gradeEn = { 녹박: 'GREEN', 적박: 'CRIMSON', 골드: 'GOLD', 로얄: 'ROYAL' }[gradeKey] || '';
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= 품종명 %> · 디지털 보증서 | ARK PROJECT</title>
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= 품종명 %> · 정품 디지털 보증서" />
  <meta property="og:description" content="ARK PROJECT BY JIYANG · <%= 고유번호 %> · <%= 상태 %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <% if (사진) { %><meta property="og:image" content="<%= 사진 %>" /><% } %>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Noto+Serif+KR:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    /* ── 기본(그린) 팔레트 ── */
    :root { --g1:#1F4129; --g2:#122A18; --g3:#0C1F10; --gold:#D2AC55; --gold2:#E9D6A0; --ink:#F6F0DF; --sealA:#E8CE72; --sealB:#95762B; }
    /* ── 등급별 팔레트: 받는 분의 느낌이 다르게 ── */
    body.grade-적박 { --g1:#571323; --g2:#360A14; --g3:#22050C; --gold:#E0B36A; --gold2:#F1DDB4; --sealA:#F2D695; --sealB:#A87F35; }
    body.grade-골드 { --g1:#423312; --g2:#241B08; --g3:#151004; --gold:#E8C468; --gold2:#F4E3B2; --sealA:#F4DE9A; --sealB:#A8842F; }
    body.grade-로얄 { --g1:#1E1B17; --g2:#100E0B; --g3:#060505; --gold:#D8B25C; --gold2:#EBD8A4; --sealA:#EAD088; --sealB:#A07E2F; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Malgun Gothic','맑은 고딕','Apple SD Gothic Neo',sans-serif; background:radial-gradient(circle at 50% 0%, var(--g1) 0%, var(--g2) 48%, var(--g3) 100%); color:var(--ink); min-height:100vh; padding:34px 16px 64px; -webkit-font-smoothing:antialiased; }
    .card { max-width:500px; margin:0 auto; background:linear-gradient(178deg,var(--g1),var(--g2) 55%,var(--g3)); border:1px solid var(--gold); border-radius:16px; box-shadow:0 26px 60px rgba(0,0,0,0.55), inset 0 0 0 1px rgba(233,214,160,0.10); overflow:hidden; position:relative; padding:44px 34px 30px; }
    /* 모노그램 워터마크 */
    .card::before { content:'A'; position:absolute; top:44%; left:50%; transform:translate(-50%,-50%); font-family:'Playfair Display',serif; font-size:400px; color:rgba(210,172,85,0.055); pointer-events:none; line-height:1; }
    .inner { position:relative; }
    /* 상단 브랜드 (중앙) */
    .head { text-align:center; margin-bottom:24px; }
    .brand { font-family:'Playfair Display',serif; letter-spacing:7px; font-size:16px; color:var(--gold); text-transform:uppercase; }
    .by { font-family:'Playfair Display',serif; letter-spacing:5px; font-size:10px; color:var(--gold2); opacity:0.85; text-transform:uppercase; margin-top:6px; }
    .coa { font-family:'Cormorant Garamond',serif; letter-spacing:4px; font-size:12px; color:var(--gold2); opacity:0.9; text-transform:uppercase; margin-top:14px; }
    /* 사진 */
    .photo-frame { border:1.5px solid var(--gold); border-radius:10px; padding:7px; background:rgba(0,0,0,0.28); margin-bottom:22px; }
    .photo-frame svg, .photo-frame img { width:100%; display:block; border-radius:6px; aspect-ratio:4/3; object-fit:cover; }
    /* ↓ 여기서부터 갤러리 캡션(좌측 정렬) */
    .variety { font-family:'Cormorant Garamond','Noto Serif KR',serif; font-size:30px; font-weight:600; color:#fff; line-height:1.25; text-align:left; }
    .plant-id { color:var(--gold); letter-spacing:2px; font-size:13px; margin:7px 0 18px; text-align:left; }
    .info { margin-bottom:6px; }
    .row { display:flex; gap:14px; font-size:13.5px; padding:5px 0; }
    .row .k { min-width:92px; color:var(--gold2); opacity:0.85; }
    .row .v { color:#fff; }
    .section-title { font-family:'Playfair Display',serif; color:var(--gold); letter-spacing:2px; font-size:12px; text-transform:uppercase; margin:20px 0 8px; }
    .tl-item { position:relative; padding:0 0 12px 20px; font-size:13px; }
    .tl-item::before { content:''; position:absolute; left:2px; top:5px; width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 3px rgba(210,172,85,0.2); }
    .tl-item::after { content:''; position:absolute; left:5.5px; top:14px; bottom:0; width:1px; background:rgba(210,172,85,0.3); }
    .tl-item:last-child::after { display:none; }
    .tl-item .who { color:#fff; }
    .tl-item .when { color:var(--gold2); opacity:0.8; font-size:11.5px; }
    .message { margin:20px 0 16px; font-size:13px; line-height:1.85; color:var(--gold2); font-style:italic; }
    .sign-seal { display:flex; align-items:flex-end; justify-content:space-between; gap:14px; margin-top:6px; }
    .signature { font-family:'Cormorant Garamond',serif; font-size:22px; color:#fff; }
    .signature small { display:block; font-family:'Malgun Gothic','맑은 고딕',sans-serif; font-size:10px; color:var(--gold2); letter-spacing:2px; margin-top:3px; }
    .seal { width:82px; height:82px; border-radius:50%; background:radial-gradient(circle at 35% 30%, var(--sealA), var(--gold) 58%, var(--sealB)); color:var(--g3); display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:'Playfair Display',serif; font-size:10px; letter-spacing:1px; border:2px solid var(--gold2); box-shadow:0 6px 16px rgba(0,0,0,0.45); flex-shrink:0; }
    .badges { display:flex; align-items:center; gap:10px; margin-top:18px; }
    .status-badge { font-size:11px; letter-spacing:2px; color:var(--g3); background:var(--gold2); padding:4px 14px; border-radius:20px; font-weight:700; }
    .grade-badge { font-size:10px; letter-spacing:3px; color:var(--gold); border:1px solid var(--gold); padding:4px 12px; border-radius:20px; }
    /* 등급별 하단 무늬 */
    .motif { height:10px; margin:24px -34px 14px; opacity:0.85; }
    .motif.기본, .motif.녹박 { background:repeating-linear-gradient(45deg, var(--gold) 0 2px, transparent 2px 10px); }
    .motif.적박 { background:repeating-linear-gradient(-45deg, var(--gold) 0 6px, transparent 6px 12px); height:7px; }
    .motif.골드 { background:linear-gradient(var(--gold), var(--gold)) top/100% 1.5px no-repeat, linear-gradient(var(--gold), var(--gold)) bottom/100% 1.5px no-repeat, repeating-linear-gradient(90deg, var(--gold) 0 8px, transparent 8px 16px) center/100% 3px no-repeat; }
    .motif.로얄 { background:repeating-linear-gradient(90deg, var(--gold) 0 12px, transparent 12px 16px, var(--gold2) 16px 18px, transparent 18px 30px); height:6px; box-shadow:0 4px 0 -2.5px var(--gold), 0 -4px 0 -2.5px var(--gold); }
    .footer { text-align:center; color:var(--gold2); opacity:0.6; font-size:10.5px; letter-spacing:1px; line-height:1.8; }
  </style>
</head>
<body class="grade-<%= gradeKey %>">
  <div class="card">
    <div class="inner">
      <div class="head">
        <div class="brand">Ark Project</div>
        <div class="by">By Jiyang</div>
        <div class="coa">Certificate of Authenticity</div>
      </div>

      <div class="photo-frame">
        <% if (사진) { %>
        <img src="<%= 사진 %>" alt="<%= 품종명 %>" />
        <% } else { %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="bg" cx="45%" cy="38%" r="75%">
              <stop offset="0%" stop-color="#3a7d55"/>
              <stop offset="55%" stop-color="#1f5135"/>
              <stop offset="100%" stop-color="#0c2417"/>
            </radialGradient>
          </defs>
          <rect width="480" height="360" fill="url(#bg)"/>
          <g transform="translate(240,212)" stroke="#0c2417" stroke-width="1.5">
            <ellipse cx="0" cy="0" rx="120" ry="48" fill="#246b45"/>
            <path d="M0 0 L-14 -150 L14 -150 Z" fill="#bfe8cf"/>
            <path d="M0 0 L-70 -120 L-44 -135 Z" fill="#a9dcbd"/>
            <path d="M0 0 L70 -120 L44 -135 Z" fill="#a9dcbd"/>
            <path d="M0 0 L-115 -60 L-92 -86 Z" fill="#9fd4b3"/>
            <path d="M0 0 L115 -60 L92 -86 Z" fill="#9fd4b3"/>
            <path d="M0 0 L-44 -140 L-18 -150 Z" fill="#d9f3e3"/>
            <path d="M0 0 L44 -140 L18 -150 Z" fill="#d9f3e3"/>
          </g>
          <text x="240" y="346" fill="#D2AC55" font-size="14" text-anchor="middle" font-family="serif" letter-spacing="2">사진 준비 중</text>
        </svg>
        <% } %>
      </div>

      <div class="variety"><%= 품종명 %></div>
      <div class="plant-id"><%= 고유번호 %></div>

      <div class="info">
        <% if (육종가) { %><div class="row"><span class="k">육종가</span><span class="v"><%= 육종가 %></span></div><% } %>
        <% if (육종연도) { %><div class="row"><span class="k">육종 연도</span><span class="v"><%= 육종연도 %></span></div><% } %>
        <% if (교배) { %><div class="row"><span class="k">교배 정보</span><span class="v"><%= 교배 %></span></div><% } %>
        <% if (마커) { %><div class="row"><span class="k">DNA 마커</span><span class="v"><%= 마커 %></span></div><% } %>
        <% if (소유자) { %><div class="row"><span class="k">현재 소유자</span><span class="v"><%= 소유자 %></span></div><% } %>
        <% if (발급일) { %><div class="row"><span class="k">발급일</span><span class="v"><%= 발급일 %></span></div><% } %>
      </div>

      <% if (이력.length > 0) { %>
      <div class="section-title">Provenance · 소유 이력</div>
      <div class="timeline">
        <% 이력.forEach(function (item) { %>
        <div class="tl-item">
          <div class="who"><%= item.who %></div>
          <% if (item.when) { %><div class="when"><%= item.when %></div><% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <div class="message"><%= 메시지 %></div>

      <div class="sign-seal">
        <div class="signature">지양하월시아<small>JIYANG HAWORTHIA · 대표</small></div>
        <div class="seal"><span>JIYANG</span><span>ARK·認證</span></div>
      </div>

      <div class="badges">
        <span class="status-badge"><%= 상태 %></span>
        <% if (gradeEn) { %><span class="grade-badge"><%= gradeEn %> GRADE</span><% } %>
      </div>

      <div class="motif <%= gradeKey %>"></div>

      <div class="footer">
        본 보증서는 지양하월시아 방주 프로젝트의 디지털 인증서입니다.<br/>
        무단 증식 및 불법 유통은 협의서에 따라 제한됩니다.
      </div>
    </div>
  </div>
</body>
</html>
