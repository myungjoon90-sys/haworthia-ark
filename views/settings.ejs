<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>설정 | ARK PROJECT</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --gold-soft:#E8D9A0; --line:rgba(212,175,55,0.22); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Malgun Gothic','맑은 고딕','Apple SD Gothic Neo',sans-serif; background:linear-gradient(160deg,#1A3620,#0E1F12); color:#FBF8F0; min-height:100vh; padding:26px 14px 60px; }
    .wrap { max-width:760px; margin:0 auto; }
    h1 { font-size:19px; font-weight:600; margin-bottom:6px; }
    .desc { font-size:13px; color:var(--gold-soft); opacity:0.8; margin-bottom:18px; line-height:1.7; }
    .addbox { display:flex; gap:8px; margin-bottom:20px; }
    .addbox input { flex:1; padding:13px; border-radius:8px; font-size:15px; border:1px solid rgba(212,175,55,0.30); background:rgba(255,255,255,0.06); color:#fff; font-family:inherit; }
    .addbox button { background:linear-gradient(180deg,#E6C75A,#D4AF37); color:#10220f; border:none; border-radius:8px; padding:0 22px; font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; }
    .item { display:flex; gap:12px; align-items:flex-start; background:rgba(0,0,0,0.22); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:10px; }
    .item .date { font-size:12px; color:var(--gold-soft); opacity:0.7; white-space:nowrap; padding-top:2px; }
    .item .text { flex:1; font-size:14px; line-height:1.6; }
    .item .st { font-size:12px; padding:4px 10px; border-radius:14px; white-space:nowrap; }
    .st.대기 { background:rgba(212,175,55,0.15); color:var(--gold-soft); border:1px solid rgba(212,175,55,0.4); }
    .st.완료 { background:rgba(80,180,110,0.2); color:#BFE8CF; border:1px solid rgba(120,200,150,0.4); }
    .ok { margin-bottom:14px; padding:12px 15px; border-radius:10px; font-size:13.5px; background:rgba(212,175,55,0.12); border:1px solid rgba(212,175,55,0.5); color:var(--gold-soft); }
    .err { margin-bottom:14px; padding:12px 15px; border-radius:10px; font-size:13.5px; background:rgba(180,50,50,0.18); border:1px solid rgba(220,100,100,0.5); color:#ffd9d9; }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('partials/nav', { active: 'settings', grades: grades }) %>
    <h1>⚙ 설정 — 수정·추가할 기능 목록</h1>
    <div class="desc">앞으로 고치거나 넣고 싶은 기능을 여기에 적어두세요. 구글 시트 '설정' 탭에 저장되며, Claude와 다음 작업할 때 이 목록을 보고 진행하면 됩니다. 완료 표시는 시트에서 상태 칸을 '완료'로 바꾸면 됩니다.</div>
    <% if (added) { %><div class="ok">✅ 목록에 추가되었습니다.</div><% } %>
    <% if (error) { %><div class="err">⚠️ <%= error %></div><% } %>
    <form class="addbox" method="post" action="/admin/settings">
      <input type="text" name="item" placeholder="예: 보증서에 QR코드 자동 생성 넣기" />
      <button type="submit">추가</button>
    </form>
    <% items.forEach(function (it) { %>
    <div class="item">
      <span class="date"><%= it.등록일 %></span>
      <span class="text"><%= it.항목 %></span>
      <span class="st <%= it.상태 === '완료' ? '완료' : '대기' %>"><%= it.상태 %></span>
    </div>
    <% }); %>
    <% if (!items.length) { %><div class="desc">아직 항목이 없습니다.</div><% } %>
  </div>
</body>
</html>
