<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>개체 등록 + 보증서 발송 | ARK PROJECT</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --gold-soft:#E8D9A0; --paper:#FBF8F0; --line:rgba(212,175,55,0.22); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Malgun Gothic','맑은 고딕','Apple SD Gothic Neo',sans-serif; background:linear-gradient(160deg,#1A3620,#0E1F12); color:var(--paper); min-height:100vh; padding:26px 14px 80px; }
    .wrap { max-width:760px; margin:0 auto; }
    .panel { background:rgba(0,0,0,0.22); border:1px solid var(--line); border-radius:14px; overflow:hidden; margin-bottom:18px; }
    .section-head { display:flex; align-items:center; gap:8px; background:rgba(212,175,55,0.10); padding:14px 18px; border-bottom:1px solid var(--line); }
    .section-head .dot { width:7px; height:7px; border-radius:50%; background:var(--gold); }
    .section-head h2 { font-size:15px; font-weight:600; color:#fff; }
    .req-note { margin-left:auto; font-size:12px; color:var(--gold-soft); opacity:0.7; }
    table.form { width:100%; border-collapse:collapse; }
    table.form tr { border-bottom:1px solid var(--line); }
    table.form tr:last-child { border-bottom:none; }
    table.form th { width:30%; text-align:left; vertical-align:top; padding:15px 16px; font-weight:500; font-size:14px; color:var(--gold-soft); background:rgba(255,255,255,0.02); }
    table.form th .star { color:var(--gold); margin-right:3px; }
    table.form td { padding:11px 16px; }
    input[type=text], input[type=tel], textarea, select { width:100%; padding:12px; border-radius:7px; font-size:15px; border:1px solid rgba(212,175,55,0.30); background:rgba(255,255,255,0.06); color:#fff; font-family:inherit; }
    select { background:#16301D; }
    input:focus, textarea:focus, select:focus { outline:none; border-color:var(--gold); }
    textarea { resize:vertical; min-height:78px; line-height:1.6; }
    .hint { font-size:12px; color:var(--gold-soft); opacity:0.65; margin-top:6px; line-height:1.5; }
    .id-row { display:flex; gap:8px; }
    .pair { display:flex; gap:10px; }
    .pair > div { flex:1; }
    .photo-btns { display:flex; gap:8px; margin-bottom:6px; }
    .photo-btns label { flex:1; text-align:center; border:1px solid rgba(212,175,55,0.45); background:rgba(212,175,55,0.12); color:var(--gold-soft); border-radius:8px; padding:12px; font-size:14px; cursor:pointer; }
    .photo-btns input { display:none; }
    #photoName { font-size:12px; color:#fff; }
    button.submit { width:100%; padding:17px; border:none; border-radius:10px; background:linear-gradient(180deg,#E6C75A,#D4AF37); color:#10220f; font-size:18px; font-weight:700; letter-spacing:1px; cursor:pointer; font-family:inherit; }
    .alert { margin-bottom:16px; padding:15px 17px; border-radius:10px; font-size:14px; line-height:1.7; }
    .alert.error { background:rgba(180,50,50,0.18); border:1px solid rgba(220,100,100,0.5); color:#ffd9d9; }
    .alert.ok { background:rgba(212,175,55,0.12); border:1px solid rgba(212,175,55,0.5); color:var(--gold-soft); }
    .alert.ok a { color:var(--gold); word-break:break-all; }
    #numStatus { font-size:12px; margin-top:6px; }
    .main-grid { display:grid; grid-template-columns:minmax(0,1fr) 380px; gap:20px; align-items:start; }
    .main-grid.nopanel { grid-template-columns:minmax(0,1fr); }
    .preview { position:sticky; top:12px; background:rgba(0,0,0,0.28); border:1px solid var(--line); border-radius:14px; overflow:hidden; display:none; }
    .preview.show { display:block; }
    .preview .p-head { display:flex; align-items:center; gap:8px; background:rgba(212,175,55,0.10); padding:12px 14px; border-bottom:1px solid var(--line); font-size:13px; color:#fff; }
    .preview .p-head small { color:var(--gold-soft); opacity:0.7; margin-left:auto; font-size:11px; }
    .preview .p-search { padding:10px 12px; border-bottom:1px solid var(--line); }
    .preview .p-search input { width:100%; padding:9px 10px; border-radius:6px; font-size:13px; border:1px solid rgba(212,175,55,0.3); background:rgba(255,255,255,0.06); color:#fff; font-family:inherit; }
    .preview .p-list { max-height:64vh; overflow:auto; }
    .p-item { padding:9px 13px; border-bottom:1px solid rgba(212,175,55,0.12); font-size:12px; line-height:1.55; cursor:pointer; }
    .p-item:hover { background:rgba(212,175,55,0.08); }
    .p-item .no { color:var(--gold); margin-right:8px; }
    .p-item .d { color:#fff; white-space:pre-wrap; word-break:break-word; }
    .p-item .owner { color:var(--gold-soft); font-size:11px; opacity:0.8; }
    .p-hint { padding:9px 13px; font-size:11px; color:var(--gold-soft); opacity:0.7; }
    @media (max-width:900px) { .main-grid { grid-template-columns:1fr; } .preview { position:static; } .preview .p-list { max-height:40vh; } }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('partials/nav', { active: 'new', grades: grades }) %>

    <% if (error) { %>
    <div class="alert error">⚠️ <%= error %></div>
    <% } %>
    <% if (result) { %>
    <div class="alert ok">
      ✅ <b><%= result.품종명 %></b> (<%= result.고유번호 %>) 등록 완료 — 구글 시트에 저장되었습니다.
      <% if (result.gradeTab) { %><br/>📗 등급 시트 <b><%= result.gradeTab %></b> 맨 아래에도 추가되었습니다.<% } %>
      <% if (result.사진URL) { %><br/>📷 사진 업로드 완료.<% } %>
      <% if (result.send) { %>
      <br/>📨 <b><%= result.send.phone %></b> 번호로 <b><%= result.send.channel %></b> 보증서 발송 완료 — 상태가 <b>정품 인증</b>으로 바뀌었습니다.
      <% } else { %>
      <br/>ℹ️ 전화번호를 입력하지 않아 발송은 하지 않았습니다. 상태는 <b>미인증</b>이며, [재발송] 탭에서 언제든 발송할 수 있습니다.
      <% } %>
      <br/>보증서 보기: <a href="<%= result.url %>" target="_blank"><%= result.url %></a>
      &nbsp;|&nbsp; <a href="/admin/qr/<%= encodeURIComponent(result.고유번호) %>" target="_blank">🏷 QR 택 인쇄</a>
    </div>
    <% } %>

    <div class="main-grid nopanel" id="mainGrid">
    <form method="post" action="/admin/new" enctype="multipart/form-data">
      <div class="panel">
        <div class="section-head"><span class="dot"></span><h2>기본 정보</h2><span class="req-note">★ 필수 입력</span></div>
        <table class="form">
          <tr>
            <th><span class="star">★</span>등급 (기록될 시트)</th>
            <td>
              <select name="grade" id="gradeSel">
                <option value="">— 등급 선택 (선택하면 넘버 자동 제안) —</option>
                <% grades.forEach(function (g) { %><option value="<%= g %>"><%= g %></option><% }); %>
              </select>
              <div class="hint">선택한 등급 시트의 맨 아래 넘버에 이어서 다음 넘버가 자동으로 만들어지고, 연도(예: 26)는 올해로 자동 반영됩니다.</div>
            </td>
          </tr>
          <tr>
            <th><span class="star">★</span>고유번호 (넘버)</th>
            <td>
              <input type="text" name="plantId" id="plantId" value="<%= form['plantId'] || '' %>" placeholder="등급을 선택하면 자동 입력됩니다" />
              <div id="numStatus" class="hint"></div>
            </td>
          </tr>
          <tr>
            <th><span class="star">★</span>품종명</th>
            <td>
              <input type="text" name="variety" list="varietyList" id="varietyInput" value="<%= form['variety'] || '' %>" placeholder="입력하면 시트의 품종명이 자동완성됩니다" autocomplete="off" />
              <datalist id="varietyList"></datalist>
            </td>
          </tr>
        </table>
      </div>

      <div class="panel">
        <div class="section-head"><span class="dot"></span><h2>육종 정보</h2></div>
        <table class="form">
          <tr><th>육종가</th><td><input type="text" name="breeder" value="<%= form['breeder'] || '지양하월시아' %>" /></td></tr>
          <tr><th>육종 연도</th><td><input type="text" name="bredYear" value="<%= form['bredYear'] || '' %>" placeholder="예: 2024" /></td></tr>
          <tr>
            <th>모본 · 부본</th>
            <td>
              <div class="pair">
                <div><input type="text" name="mother" value="<%= form['mother'] || '' %>" placeholder="모본 (씨받이)" /></div>
                <div><input type="text" name="father" value="<%= form['father'] || '' %>" placeholder="부본 (꽃가루)" /></div>
              </div>
            </td>
          </tr>
          <tr><th>DNA 마커</th><td><input type="text" name="dna" value="<%= form['dna'] || '' %>" /></td></tr>
        </table>
      </div>

      <div class="panel">
        <div class="section-head"><span class="dot"></span><h2>사진 · 메시지</h2></div>
        <table class="form">
          <tr>
            <th>개체 사진</th>
            <td>
              <div class="photo-btns">
                <label>📁 사진 파일 선택<input type="file" name="photo" id="photoFile" accept="image/*" /></label>
                <label>📷 바로 촬영 (휴대폰)<input type="file" id="photoCam" accept="image/*" capture="environment" /></label>
              </div>
              <span id="photoName">선택된 사진 없음</span>
              <div class="hint">휴대폰에서 열면 [바로 촬영]으로 카메라가 켜집니다. 업로드한 사진은 보증서에 자동으로 들어갑니다.</div>
            </td>
          </tr>
          <tr>
            <th>관리자 메시지</th>
            <td><textarea name="adminMsg" placeholder="비우면 기본 환영 문구가 들어갑니다."><%= form['adminMsg'] || '' %></textarea></td>
          </tr>
        </table>
      </div>

      <div class="panel">
        <div class="section-head"><span class="dot"></span><h2>소유 정보 · 발송</h2></div>
        <table class="form">
          <tr><th>구매자</th><td><input type="text" name="owner" value="<%= form['owner'] || '' %>" placeholder="예: 홍길동 (보증서의 구매자로 표시됩니다)" /></td></tr>
          <tr>
            <th>소유자 이전 기록</th>
            <td>
              <textarea name="history" placeholder="예: 2026-09-02 | 홍길동님 분양"><%= form['history'] || '' %></textarea>
              <div class="hint">"최초 육종 (지양하월시아)" 줄은 자동으로 맨 위에 들어가니 적지 않으셔도 됩니다. 한 줄 = 타임라인 한 칸.</div>
            </td>
          </tr>
          <tr>
            <th>고객 휴대폰 번호</th>
            <td>
              <input type="tel" name="phone" value="<%= form['phone'] || '' %>" placeholder="예: 01012345678 — 입력하면 등록 즉시 보증서가 발송됩니다" />
              <div class="hint">입력 시: 등록 → 보증서 자동 발송 → 상태 '정품 인증'. 비우면: 등록만 하고 상태 '미인증'.</div>
            </td>
          </tr>
        </table>
      </div>

      <button class="submit" type="submit">개체 등록 + 보증서 발송</button>
    </form>

    <aside class="preview" id="previewPanel">
      <div class="p-head">📗 <span id="pvTitle">시트 미리보기</span><small id="pvCount"></small></div>
      <div class="p-search"><input type="text" id="pvSearch" placeholder="번호·품종명 검색 (예: 다알리아)" /></div>
      <div class="p-list" id="pvList"><div class="p-hint">등급을 선택하면 해당 시트의 번호와 내용(D열)이 여기 표시됩니다. 줄을 클릭하면 내용이 복사됩니다.</div></div>
    </aside>
    </div>
  </div>

  <script>
    // 등급 선택 → 다음 넘버 자동 제안 + 품종명 자동완성 목록 불러오기
    var gradeSel = document.getElementById('gradeSel');
    var plantId = document.getElementById('plantId');
    var numStatus = document.getElementById('numStatus');
    var varietyList = document.getElementById('varietyList');

    gradeSel.addEventListener('change', function () {
      var g = gradeSel.value;
      if (!g) return;
      numStatus.textContent = '넘버 계산 중...';
      fetch('/api/next-number?grade=' + encodeURIComponent(g))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.ok) {
            plantId.value = d.suggest;
            numStatus.textContent = '✔ ' + d.tab + ' 시트 맨 아래 넘버(' + d.last + ') 다음 번호입니다. 수정도 가능합니다.';
          } else {
            numStatus.textContent = '⚠ ' + d.error;
          }
        })
        .catch(function () { numStatus.textContent = '⚠ 넘버 제안 실패 — 직접 입력해 주세요.'; });
      loadPreview(g);
      fetch('/api/varieties?grade=' + encodeURIComponent(g))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          varietyList.innerHTML = '';
          (d.names || []).forEach(function (n) {
            var o = document.createElement('option');
            o.value = n;
            varietyList.appendChild(o);
          });
        })
        .catch(function () {});
    });

    // 등급 시트 미리보기 패널
    var pvPanel = document.getElementById('previewPanel');
    var pvList = document.getElementById('pvList');
    var pvTitle = document.getElementById('pvTitle');
    var pvCount = document.getElementById('pvCount');
    var pvSearch = document.getElementById('pvSearch');
    var pvRows = [];

    function renderPreview(filter) {
      var q = (filter || '').trim().toLowerCase();
      var rows = pvRows;
      if (q) rows = rows.filter(function (r) { return (r.no + ' ' + r.d + ' ' + r.owner).toLowerCase().indexOf(q) !== -1; });
      var html = '';
      var shown = rows.slice(-400); // 아래쪽(최신) 위주로 표시
      for (var i = shown.length - 1; i >= 0; i--) {
        var r = shown[i];
        html += '<div class="p-item" data-d="' + encodeURIComponent(r.d) + '">'
          + '<span class="no">' + (r.no || r.row + '행') + '</span>'
          + '<span class="d">' + r.d.replace(/</g, '&lt;').replace(/\n/g, '<br/>') + '</span>'
          + (r.owner ? '<div class="owner">등록자: ' + r.owner + '</div>' : '')
          + '</div>';
      }
      pvList.innerHTML = html || '<div class="p-hint">검색 결과가 없습니다.</div>';
      pvCount.textContent = rows.length + '행';
    }

    function loadPreview(g) {
      pvPanel.classList.add('show');
      document.getElementById('mainGrid').classList.remove('nopanel');
      pvTitle.textContent = g + ' 시트';
      pvList.innerHTML = '<div class="p-hint">불러오는 중...</div>';
      fetch('/api/sheet-preview?grade=' + encodeURIComponent(g))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          pvRows = d.rows || [];
          pvTitle.textContent = (d.tab || g) + '';
          renderPreview('');
        })
        .catch(function () { pvList.innerHTML = '<div class="p-hint">불러오기 실패</div>'; });
    }

    pvSearch.addEventListener('input', function () { renderPreview(pvSearch.value); });
    pvList.addEventListener('click', function (e) {
      var item = e.target.closest('.p-item');
      if (!item) return;
      var text = decodeURIComponent(item.getAttribute('data-d'));
      (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(function () {
        item.style.background = 'rgba(212,175,55,0.25)';
        setTimeout(function () { item.style.background = ''; }, 400);
      }).catch(function () {});
    });

    // 사진 선택/촬영 → 하나의 photo 입력으로 합치기
    var photoFile = document.getElementById('photoFile');
    var photoCam = document.getElementById('photoCam');
    var photoName = document.getElementById('photoName');
    photoFile.addEventListener('change', function () {
      if (photoFile.files.length) photoName.textContent = '✔ ' + photoFile.files[0].name;
    });
    photoCam.addEventListener('change', function () {
      if (photoCam.files.length) {
        var dt = new DataTransfer();
        dt.items.add(photoCam.files[0]);
        photoFile.files = dt.files;
        photoName.textContent = '✔ 촬영한 사진 1장';
      }
    });
  </script>
</body>
</html>
