<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= post.제목 %> | 방주 커뮤니티</title>
  <meta name="robots" content="noindex" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Noto+Serif+KR:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D2AC55; --gold2:#E9D6A0; --line:rgba(210,172,85,0.3); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Noto Serif KR','Malgun Gothic','맑은 고딕','Apple SD Gothic Neo',serif; background:radial-gradient(circle at 50% -10%, #1F4129 0%, #122A18 50%, #050a06 100%); color:#F6F0DF; min-height:100vh; padding:44px 18px 80px; }
    .wrap { max-width:620px; margin:0 auto; }
    .back { font-size:12px; margin-bottom:18px; }
    .back a { color:var(--gold2); text-decoration:none; }
    .card { background:rgba(0,0,0,0.3); border:1px solid var(--line); border-radius:14px; padding:22px; }
    h1 { font-size:19px; font-weight:600; color:#F3E8CC; letter-spacing:1px; line-height:1.6; }
    .meta { font-size:11.5px; color:var(--gold2); opacity:0.75; margin-top:8px; }
    .photo { margin-top:16px; border-radius:10px; overflow:hidden; border:1px solid var(--line); }
    .photo img { width:100%; display:block; }
    .body { margin-top:16px; font-size:14px; line-height:2.0; color:#EDE6D4; white-space:pre-line; }
    .cmts { margin-top:26px; }
    .cmts h2 { font-size:13px; color:var(--gold); letter-spacing:2px; margin-bottom:12px; }
    .cmt { padding:12px 2px; border-bottom:1px solid rgba(210,172,85,0.14); }
    .cmt .who { font-size:12px; color:var(--gold2); }
    .cmt .who b { color:#F3E8CC; font-size:13px; }
    .cmt .tx { font-size:13.5px; line-height:1.9; margin-top:5px; color:#EDE6D4; white-space:pre-line; }
    form.reply { display:flex; gap:9px; margin-top:16px; }
    form.reply input { flex:1; padding:12px; border-radius:9px; font-size:14px; border:1px solid rgba(210,172,85,0.3); background:rgba(255,255,255,0.06); color:#fff; font-family:inherit; }
    form.reply button { padding:12px 18px; border:none; border-radius:9px; background:linear-gradient(180deg,#E6C75A,#D2AC55); color:#10220f; font-size:13.5px; font-weight:700; cursor:pointer; font-family:inherit; white-space:nowrap; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="back"><a href="/community">← 커뮤니티 목록</a></div>
    <div class="card">
      <h1><%= post.제목 %></h1>
      <div class="meta"><%= post.작성자 %> · <%= post.일시 %></div>
      <% if (post.사진URL) { %><div class="photo"><img src="<%= post.사진URL %>" alt="" /></div><% } %>
      <% if (post.내용) { %><div class="body"><%= post.내용 %></div><% } %>

      <div class="cmts">
        <h2>댓글 <%= post.댓글.length %></h2>
        <% post.댓글.forEach(function (c) { %>
        <div class="cmt">
          <div class="who"><b><%= c.작성자 %></b> · <%= c.일시 %></div>
          <div class="tx"><%= c.내용 %></div>
        </div>
        <% }); %>
        <form class="reply" method="post" action="/community/<%= post.번호 %>/comment">
          <input type="text" name="text" placeholder="<%= me.nick %>님, 댓글을 남겨주세요" />
          <button type="submit">등록</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
