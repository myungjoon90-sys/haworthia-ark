<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>관리자 로그인 | ARK PROJECT</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --gold-soft:#E8D9A0; --paper:#FBF8F0; --line:rgba(212,175,55,0.22); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Malgun Gothic','맑은 고딕','Apple SD Gothic Neo','Noto Sans KR',sans-serif; background:linear-gradient(160deg,#1A3620,#0E1F12); color:var(--paper); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px; }
    .box { width:100%; max-width:380px; background:rgba(0,0,0,0.25); border:1px solid var(--line); border-radius:16px; padding:36px 28px; text-align:center; }
    .crest { width:44px; height:44px; margin:0 auto 14px; border:1.5px solid var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--gold); font-size:20px; }
    .logo { font-family:'Playfair Display',serif; color:var(--gold); letter-spacing:3px; font-size:15px; margin-bottom:6px; }
    .sub { font-size:12px; color:var(--gold-soft); opacity:0.7; margin-bottom:26px; letter-spacing:1px; }
    input[type=password] { width:100%; padding:13px 12px; border-radius:7px; font-size:15px; border:1px solid rgba(212,175,55,0.30); background:rgba(255,255,255,0.06); color:#fff; font-family:inherit; text-align:center; letter-spacing:2px; }
    input:focus { outline:none; border-color:var(--gold); }
    button { width:100%; margin-top:16px; padding:14px; border:none; border-radius:9px; background:linear-gradient(180deg,#E6C75A,#D4AF37); color:#10220f; font-size:15px; font-weight:700; letter-spacing:1px; cursor:pointer; font-family:inherit; }
    .error { margin-top:14px; font-size:13px; color:#ffb9b9; }
  </style>
</head>
<body>
  <div class="box">
    <div class="crest">&#10086;</div>
    <div class="logo">ARK PROJECT</div>
    <div class="sub">JIYANG HAWORTHIA · 관리자 전용</div>
    <form method="post" action="/admin/login">
      <input type="password" name="password" placeholder="관리자 비밀번호" autofocus />
      <button type="submit">로그인</button>
    </form>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
  </div>
</body>
</html>
