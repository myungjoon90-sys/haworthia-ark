<%- include('_head') %>
<div class="dhero">
  <a class="who" href="<%= B %>/u/<%= encodeURIComponent(u.nick) %>"><span class="ava"><%= u.nick.slice(0,1) %></span><span><b><%= u.nick %></b><%- include('_badges', { u: u }) %></span></a>
  <h1>🌱 <a href="<%= B %>/t/<%= encodeURIComponent(key) %>">#<%= word %></a> <%= t('성장일기') %></h1>
  <div class="dstat">
    <div><b><%= total %></b><small><%= t('기록') %></small></div>
    <div><b>D+<%= span %></b><small><%= t('키운 기간') %></small></div>
    <div><b><%= T.ymd(first.created_at).slice(2) %></b><small><%= t('첫 기록') %></small></div>
    <div><b><%= T.ymd(last.created_at).slice(2) %></b><small><%= t('최근 기록') %></small></div>
  </div>
  <% if (total >= 2) { var a = first.photos[0], z = last.photos[0]; %>
  <div class="dvs">
    <a href="<%= B %>/p/<%= first.id %>"><img src="<%= B %>/media/<%= a.thumb %>" alt=""><span>D+0</span></a>
    <i>→</i>
    <a href="<%= B %>/p/<%= last.id %>"><img src="<%= B %>/media/<%= z.thumb %>" alt=""><span>D+<%= span %></span></a>
  </div>
  <% } %>
</div>
<% if (card) { %>
<button class="btn sharecard" type="button" id="cardbtn">🎬 <%= t('비교 사진 만들기 · 공유') %></button>
<script type="application/json" id="carddata"><%- JSON.stringify(card).replace(/</g, '\\u003c') %></script>
<div class="csheet" id="csheet" hidden>
  <div class="dim" data-close></div>
  <div class="panel" role="dialog" aria-label="<%= t('비교 사진 만들기') %>">
    <div class="grab"></div>
    <div class="ch"><b>🎬 <%= t('비교 사진 만들기') %></b><button type="button" class="x" data-close aria-label="<%= t('닫기') %>">✕</button></div>
    <div class="seg3"><button type="button" data-fmt="story"><%= t('세로 9:16') %></button><button type="button" data-fmt="square" class="on"><%= t('정사각 1:1') %></button><button type="button" data-fmt="tl"><%= t('타임라인 4:5') %></button></div>
    <div class="cprev"><img id="cimg" alt=""><span class="cwait"><%= t('만드는 중…') %></span></div>
    <div class="cbt"><button type="button" class="sv" id="csave">⬇ <%= t('사진 저장') %></button><button type="button" class="sh" id="cshare"><%= t('공유하기') %></button></div>
    <p class="hint" style="margin-top:8px;text-align:center"><%= t('인스타그램·틱톡·카카오톡에 공유할 수 있습니다. QR을 찍으면 이 성장일기로 연결됩니다.') %></p>
  </div>
</div>
<% } %>
<div class="dord">
  <a class="chip <%= order === 'old' ? 'on' : '' %>" href="?order=old"><%= t('처음부터') %></a>
  <a class="chip <%= order === 'new' ? 'on' : '' %>" href="?order=new"><%= t('최근부터') %></a>
  <% if (own) { %><a class="btn gold s" style="margin-left:auto" href="<%= B %>/write?tag=<%= encodeURIComponent(word) %>">＋ <%= t('오늘 기록 등록') %></a><% } %>
</div>
<div class="dtline">
  <% entries.forEach(function (e) { var ph = e.photos[0]; %>
  <article class="dtl">
    <div class="dtld"><b>D+<%= e.day %></b><small><%= T.ymd(e.created_at) %></small><% if (e.gap !== null && order === 'old') { %><small class="gap"><%= t('+{n}일', { n: e.gap }) %></small><% } %></div>
    <div class="dtlc">
      <a class="dtli" href="<%= B %>/p/<%= e.id %>" style="aspect-ratio:<%= ph.w && ph.h ? ph.w + '/' + Math.round(Math.min(ph.h, ph.w * 1.35)) : '1/1' %>"><img src="<%= B %>/media/<%= ph.file %>" loading="lazy" alt=""><% if (e.photos.length > 1) { %><span class="multi">❐ <%= e.photos.length %></span><% } %><% if (e.hidden) { %><span class="hidb"><%= t('숨김') %></span><% } %></a>
      <% if (e.body) { %><div class="dtlb"><%- T.renderBody(String(e.body).length > 220 ? String(e.body).slice(0, 220) + '…' : e.body, B) %></div><% } %>
      <a class="dtlm" href="<%= B %>/p/<%= e.id %>">♡ <%= e.likes %> · 💬 <%= e.comments %> · <%= t('게시물 보기 →') %></a>
    </div>
  </article>
  <% }); %>
</div>
<%- include('_foot', { tab: own ? 'me' : '' }) %>
