<footer class="sitefoot"><span><%= t('하월시아 클럽') %></span><a href="<%= B %>/levels"><%= t('등급 안내') %></a><a href="<%= B %>/privacy"><%= t('개인정보처리방침') %></a><a class="arklink" href="<%= B %>/ark"><%= t('방주') %></a></footer>
<div class="langbar">🌐 <% LANGS.forEach(function (l, i) { %><%- i ? '<span>|</span>' : '' %><a href="?lang=<%= l.code %>" class="<%= lang === l.code ? 'on' : '' %>" hreflang="<%= l.code %>"><%= l.label %></a><% }); %></div>
</main>
<% var tb = (typeof tab !== 'undefined') ? tab : ''; %>
<nav class="tabs"><div class="in">
  <a href="<%= B %>/" class="<%= tb==='feed'?'on':'' %>"><span class="ic">🏡</span><%= t('피드') %></a>
  <a href="<%= B %>/?sort=hot" class="<%= tb==='hot'?'on':'' %>"><span class="ic">🔥</span><%= t('인기') %></a>
  <a href="<%= B %>/write" class="plus" aria-label="<%= t('글쓰기') %>"><span class="ic">＋</span><%= t('글쓰기') %></a>
  <a href="<%= B %>/dex" class="<%= tb==='dex'?'on':'' %>"><span class="ic">📖</span><%= t('도감') %></a>
  <a href="<%= B %>/me" class="<%= tb==='me'?'on':'' %>"><span class="ic">🪴</span><%= t('온실') %></a>
</div></nav>
<div id="toast" class="toast"></div>
<script>window.CLUB_I18N=<%- JSON.stringify(jsDict) %>;</script>
<script src="<%= B %>/static/club.js?v=<%= VERSION %>"></script>
</body>
</html>
