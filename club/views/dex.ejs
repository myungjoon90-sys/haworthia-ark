<%- include('_head') %>
<div style="padding:16px 0 0"><h1 style="font-size:20px"><%= t('품종 도감') %></h1><p class="hint"><%= t('회원들이 #품종명으로 올린 사진이 품종별로 모입니다. 각 품종에는 이번 달 대표 사진이 표시됩니다.') %></p></div>
<form class="search" method="get" action="<%= B %>/dex"><input name="q" value="<%= qtext %>" placeholder="<%= t('품종 찾기 (예: 미카엘)') %>"><% if (sort === 'abc') { %><input type="hidden" name="sort" value="abc"><% } %></form>
<div class="chips"><a class="chip <%= sort==='many'?'on':'' %>" href="<%= B %>/dex<%= qtext ? '?q=' + encodeURIComponent(qtext) : '' %>"><%= t('사진 많은 순') %></a><a class="chip <%= sort==='abc'?'on':'' %>" href="<%= B %>/dex?sort=abc<%= qtext ? '&q=' + encodeURIComponent(qtext) : '' %>"><%= t('가나다순') %></a></div>

<div class="sec"><h2><%= t('품종') %></h2><small><%= t('{n}종', { n: tags.length }) %></small></div>
<% if (!tags.length) { %><div class="empty-st" style="padding:30px"><i>📖</i><%= qtext ? t('검색 결과가 없습니다.') : t('등록된 품종이 없습니다.') %></div><% } %>
<div class="dex">
  <% tags.forEach(function (x) { %>
  <a href="<%= B %>/t/<%= encodeURIComponent(x.key) %>">
    <div class="im"><% if (x.rep && x.rep.photos.length) { %><img src="<%= B %>/media/<%= x.rep.photos[0].thumb %>" loading="lazy" alt=""><% if (x.why === 'pin') { %><span class="pin">📌</span><% } %><% } else { %><span class="empty"><i>✎</i><%= t('텍스트 게시물') %></span><% } %></div>
    <b>#<%= T.tagWord(x.label) %></b><small><%= t('{n}장', { n: x.n }) %></small>
  </a>
  <% }); %>
</div>
<%- include('_foot', { tab: 'dex' }) %>
