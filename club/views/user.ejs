<%- include('_head') %>
<div class="prof">
  <span class="ava l"><%= u.nick.slice(0,1) %></span>
  <div style="min-width:0">
    <h1><%= u.nick %> <%- include('_badges', { u: u }) %></h1>
    <p><%= u.bio || (own ? '소개를 적어 보세요.' : '') %></p>
  </div>
</div>
<div class="stats">
  <div><b><%= plants.length %></b><small>식물</small></div>
  <div><b><%= stats.posts %></b><small>사진·글</small></div>
  <div><b><%= u.act.comments %></b><small>댓글</small></div>
  <div><b><%= stats.hearts %></b><small>받은 ♥</small></div>
</div>

<% var t = u.tier, nx = t.next; %>
<div class="lvbox">
  <div class="t"><span class="tier t-<%= t.key %>" style="font-size:13px;padding:3px 10px"><%= t.icon %> <%= t.name %></span><% if (nx) { %><span style="font-size:13px;color:var(--sub);font-weight:600">→ <%= nx.icon %> <%= nx.name %>까지</span><% } else { %><span style="font-size:13px;color:var(--sub);font-weight:600">최고 등급</span><% } %><a href="<%= B %>/levels">등급 안내</a></div>
  <% if (nx) { var pp = Math.min(100, Math.round(u.act.posts / nx.posts * 100)), cp = Math.min(100, Math.round(u.act.comments / nx.comments * 100)); %>
  <div class="row"><span>게시물 <%= u.act.posts %> / <%= nx.posts %></span><span><%= pp %>%</span></div><div class="bar"><i style="width:<%= pp %>%"></i></div>
  <div class="row"><span>댓글 <%= u.act.comments %> / <%= nx.comments %> <small>(남의 글에 단 것)</small></span><span><%= cp %>%</span></div><div class="bar"><i style="width:<%= cp %>%"></i></div>
  <% } %>
  <% if (t.ark) { %><div class="ok" style="margin-top:10px">💎 방주 가입 요건 「하월시아 클럽 활동」을 채웠습니다. <a href="<%= ARK_URL %>/join" style="font-weight:800;text-decoration:underline">방주 가입 신청 →</a></div><% } %>
</div>

<% if (own) { %>
<div style="display:flex;gap:8px;margin:6px 0">
  <button class="btn line s" data-act="/api/me/edit" data-prompt="소개 한 줄 (120자까지)" data-prompt-value="<%= u.bio %>" data-prompt-key="bio" data-go="reload">소개 고치기</button>
  <button class="btn line s" data-act="/api/me/edit" data-prompt="새 닉네임 (2~16자, 띄어쓰기 없이)" data-prompt-value="<%= u.nick %>" data-prompt-key="nick" data-go="/me">닉네임 바꾸기</button>
  <form method="post" action="<%= B %>/logout" style="margin-left:auto"><button class="btn line s" type="submit">로그아웃</button></form>
</div>
<% } %>

<div class="sec"><h2>🪴 <%= own ? '내 식물' : '식물' %></h2><small>식물마다 성장 기록이 쌓여요</small></div>
<div class="plants">
  <% plants.forEach(function (p) { %>
  <a href="<%= B %>/plant/<%= p.id %>">
    <div class="im"><% if (p.cover) { %><img src="<%= B %>/media/<%= p.cover %>" loading="lazy" alt=""><% } else { %><span class="none">🌱</span><% } %></div>
    <% if (p.cert_status === 'ok') { %><span class="c certb">🛡 정품</span><% } else if (p.cert_status === 'pending' && own) { %><span class="c certb" style="background:#fff">⏳ 확인 중</span><% } %>
    <div class="tx"><b><%= p.name %></b><small>기록 <%= p.n %>개<%= p.last_at ? ' · ' + T.timeAgo(p.last_at) : '' %></small></div>
  </a>
  <% }); %>
  <% if (own) { %><a class="add" href="#" data-act="/api/plants" data-prompt="새 식물 이름 (예: 미카엘의 심장 1호)" data-prompt-key="name"><span>＋</span>식물 추가</a><% } %>
</div>
<% if (!plants.length && !own) { %><p class="hint">아직 등록한 식물이 없어요.</p><% } %>

<div class="sec"><h2>사진</h2><small><%= stats.posts %>개</small></div>
<% if (!list.length) { %><div class="empty-st" style="padding:26px"><i>📷</i><%= own ? '첫 사진을 올려 보세요.' : '아직 올린 사진이 없어요.' %></div><% } else { %>
<div class="grid" id="gridlist"><%- include('_gridcells', { list: list }) %></div>
<% if (more) { %><button class="btn line moreb" data-more="<%= next %>" data-target="gridlist">더 보기</button><% } %>
<% } %>
<%- include('_foot', { tab: own ? 'me' : '' }) %>
