<%- include('_head') %>
<form id="writeform" data-plant="<%= pick || '' %>" <% if (edit) { %>data-edit="<%= edit.id %>"<% } %>>
  <div style="padding:16px 0 4px;display:flex;align-items:center"><h1 style="font-size:20px"><%= edit ? t('게시물 수정') : t('사진 등록') %></h1><span id="photocount" style="margin-left:auto;font-size:13px;color:var(--sub)"></span></div>

  <% if (!edit) { %>
  <div class="pick">
    <label><input type="file" accept="image/*" capture="environment"><span>📷</span><%= t('사진 찍기') %></label>
    <label><input type="file" accept="image/*" multiple><span>🖼️</span><%= t('갤러리에서 (10장까지)') %></label>
  </div>
  <div class="thumbs" id="thumbs"></div>
  <p class="hint" style="margin-top:6px"><%= t('첫 번째 사진이 대표 사진으로 등록됩니다. ✂를 누르면 표시 영역을 다시 지정할 수 있습니다.') %></p>
  <% } else { %>
  <div class="thumbs"><% edit.photos.forEach(function (p) { %><div class="t"><img src="<%= B %>/media/<%= p.thumb %>" alt=""></div><% }); %></div>
  <p class="hint"><%= t('사진은 변경할 수 없습니다. 내용과 식물만 수정할 수 있습니다.') %></p>
  <% } %>

  <label class="f"><%= t('식물 선택') %> <span style="font-weight:400;color:var(--sub)">— <%= t('선택하면 내 온실에 성장 기록으로 저장됩니다') %></span></label>
  <div class="plpick">
    <button type="button" data-id="" class="<%= !pick ? 'on' : '' %>"><%= t('선택 안 함') %></button>
    <% plants.forEach(function (p) { %><button type="button" data-id="<%= p.id %>" data-tag="<%= p.tag_key %>" class="<%= pick === p.id ? 'on' : '' %>"><%= p.cert_status === 'ok' ? '🛡' : '🌱' %> <%= p.name %></button><% }); %>
    <button type="button" data-id="new">＋ <%= t('새 식물') %></button>
  </div>
  <div id="newplant" style="display:none;margin-top:8px">
    <input class="in" id="newplantname" maxlength="40" placeholder="<%= t('예: 미카엘의 심장 1호 · 콤포트 큰 촉') %>">
    <p class="hint" style="margin-top:5px"><%= t('보증서가 있는 식물은 등록 후 식물 화면에서 「보증서 연결」을 눌러 주세요.') %></p>
  </div>

  <label class="f"><%= t('종') %> <span style="font-weight:400;color:var(--sub)">— <%= t('#품종명을 입력하면 자동으로 선택됩니다. 직접 변경할 수도 있습니다') %></span></label>
  <div class="plpick" id="sppick" data-map='<%= JSON.stringify(spMap) %>' data-cur="<%= edit ? (edit.species || 'etc') : '' %>" data-src="<%= edit ? edit.species_src : '' %>">
    <% spList.forEach(function (x) { %><button type="button" data-sp="<%= x.id %>"><%= spLabel(x) %></button><% }); %>
    <button type="button" data-sp="etc"><%= t('ETC') %></button>
  </div>

  <label class="f"><%= t('내용') %> <span style="font-weight:400;color:var(--sub)">— <%= t('#을 입력하면 품종명이 표시됩니다') %></span></label>
  <div class="acwrap">
    <textarea class="in" id="body" data-tags maxlength="2000" placeholder="<%= t('#미카엘의심장 3달 키운 모습이에요. 창이 많이 맑아졌어요.') %>"><%= edit ? edit.body : (preTag ? '#' + preTag + ' ' : '') %></textarea>
  </div>
  <% if (popular.length) { %>
  <div class="taghint"><% popular.forEach(function (x) { %><button type="button" data-addtag="<%= T.tagWord(x.label) %>">#<%= T.tagWord(x.label) %></button><% }); %></div>
  <% } %>
  <p class="hint" style="margin-top:8px"><%= t('띄어쓰기와 관계없이 같은 품종으로 묶입니다. (#미카엘의심장 = #미카엘의 심장)') %></p>

  <div class="err" id="werr"></div>
  <button class="btn gold" id="wsubmit" type="submit" style="margin:18px 0 10px"><%= edit ? t('저장') : t('등록') %></button>
</form>
<%- include('_foot', { tab: '' }) %>
