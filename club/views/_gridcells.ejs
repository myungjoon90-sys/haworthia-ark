<% list.forEach(function (c) { %><a href="<%= B %>/p/<%= c.id %>"><% if (c.photos.length) { %><img src="<%= B %>/media/<%= c.photos[0].thumb %>" loading="lazy" alt=""><% } else { %><span class="txt"><%= String(c.body || '').slice(0, 80) %></span><% } %><% if (c.photos.length > 1) { %><span class="multi">❐</span><% } %><% if (c.plant && c.plant.cert_status === 'ok') { %><span class="cert">🛡</span><% } %><% if (c.hidden) { %><span class="hid"><b>숨김</b></span><% } %><span class="ov">♥ <%= c.likes %><% if (c.comments) { %> · 💬 <%= c.comments %><% } %></span></a><% }); %>
