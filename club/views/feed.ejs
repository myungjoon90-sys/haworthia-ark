<%- include('_head') %>
<div class="install" id="install"><span style="font-size:22px">🌿</span><div><b><%= t('홈 화면에 클럽 놓기') %></b><div class="how" style="font-size:12px;opacity:.85"><%= t('앱처럼 바로 열 수 있어요') %></div></div><button class="go" type="button"><%= t('설치') %></button><button class="x" type="button" aria-label="<%= t('닫기') %>">✕</button></div>

<% var sq = function (o) { var a = []; var v = Object.assign({ s: sp, t: tk, sort: sort }, o); if (v.s) a.push('s=' + v.s); if (v.t) a.push('t=' + encodeURIComponent(v.t)); if (v.sort && v.sort !== 'new') a.push('sort=' + v.sort); return B + '/' + (a.length ? '?' + a.join('&') : ''); }; %>
<div class="chips pinchips">
  <a class="chip <%= !sp && !tk ? 'on' : '' %>" href="<%= sq({ s: '', t: '' }) %>"><%= t('전체') %></a>
  <% spList.forEach(function (x) { %><a class="chip <%= sp === x.id ? 'on' : '' %>" href="<%= sq({ s: x.id, t: '' }) %>"><%= spLabel(x) %></a><% }); %>
  <a class="chip <%= sp === 'etc' ? 'on' : '' %>" href="<%= sq({ s: 'etc', t: '' }) %>"><%= t('ETC') %></a>
</div>
<div class="sortbar">
  <% if (tk) { %><a class="tlink" href="<%= B %>/t/<%= encodeURIComponent(tk) %>"><%= t('#{tag} 품종 페이지 →', { tag: T.tagWord(tkLabel) }) %></a><a class="x" href="<%= sq({ t: '' }) %>" aria-label="✕">✕</a><% } else { %><span class="hint"><%= sp ? spName + ' · ' : '' %><%= sort === 'hot' ? t('최근 30일 반응 많은 순') : t('새로 올라온 순') %></span><% } %>
  <span class="sp"></span>
  <a class="<%= sort === 'new' ? 'on' : '' %>" href="<%= sq({ sort: 'new' }) %>"><%= t('최신') %></a>
  <a class="<%= sort === 'hot' ? 'on' : '' %>" href="<%= sq({ sort: 'hot' }) %>"><%= t('인기') %></a>
</div>

<% if (!list.length) { %>
  <div class="empty-st"><i>🪴</i><%= t('첫 사진을 기다리고 있어요.') %><br><%= t('키우는 하월시아를 #품종명 과 함께 올려 주세요.') %>
    <div style="margin-top:16px"><a class="btn gold s" href="<%= B %>/write<%= tk ? '?tag=' + encodeURIComponent(tk) : '' %>">＋ <%= t('사진 올리기') %></a></div></div>
<% } %>
<div class="masonry" id="feedlist"><% list.forEach(function (c) { %><%- include('_pin', { c: c }) %><% }); %></div>
<% if (more) { %><button class="btn line moreb" data-more="<%= next %>" data-target="feedlist"><%= t('더 보기') %></button><% } %>
<%- include('_foot', { tab: sort === 'hot' ? 'hot' : 'feed' }) %>
