<%- include('_head') %>
<div class="install" id="install"><span style="font-size:22px">🌿</span><div><b><%= t('홈 화면에 클럽 추가') %></b><div class="how" style="font-size:12px;opacity:.85"><%= t('앱처럼 바로 열 수 있습니다') %></div></div><button class="go" type="button"><%= t('설치') %></button><button class="x" type="button" aria-label="<%= t('닫기') %>">✕</button></div>

<% var sq = function (o) { var a = []; var v = Object.assign({ s: sp, t: tk, sort: sort }, o); if (v.s) a.push('s=' + v.s); if (v.t) a.push('t=' + encodeURIComponent(v.t)); if (v.sort && v.sort !== 'new') a.push('sort=' + v.sort); return B + '/' + (a.length ? '?' + a.join('&') : ''); }; %>
<% if (evBand) { %>
<a class="ev-band" href="<%= B %>/event"><span class="ic">🏆</span><div><b><%= tf(evBand.cfg.title) %> · <%= evBand.phase === 'done' ? t('결과 발표') : t('{d}까지', { d: evBand.endYmd.slice(5).replace('-', '/') }) %></b>
  <small><%= evBand.groups.slice(0, 3).map(function (g) { return (g.from === g.to ? t('{n}위', { n: g.from }) : t('{a}~{b}위', { a: g.from, b: g.to })) + ' ' + tf(g.label); }).join(' · ') %><%= evBand.groups.length > 3 ? ' · ' + t('{n}위까지 시상', { n: evBand.groups[evBand.groups.length - 1].to }) : '' %></small></div>
  <div class="me"><% if (evBand.myRank) { %><em><%= t('{n}위', { n: evBand.myRank }) %></em><span><%= t('내 순위 →') %></span><% } else { %><span><%= t('참여하기 →') %></span><% } %></div></a>
<% } %>
<div class="chips pinchips">
  <a class="chip <%= !sp && !tk ? 'on' : '' %>" href="<%= sq({ s: '', t: '' }) %>"><%= t('전체') %></a>
  <% spList.forEach(function (x) { %><a class="chip <%= sp === x.id ? 'on' : '' %>" href="<%= sq({ s: x.id, t: '' }) %>"><%= spLabel(x) %></a><% }); %>
  <a class="chip <%= sp === 'etc' ? 'on' : '' %>" href="<%= sq({ s: 'etc', t: '' }) %>"><%= t('ETC') %></a>
</div>
<div class="sortbar">
  <% if (tk) { %><a class="tlink" href="<%= B %>/t/<%= encodeURIComponent(tk) %>"><%= t('#{tag} 품종 페이지 →', { tag: T.tagWord(tkLabel) }) %></a><a class="x" href="<%= sq({ t: '' }) %>" aria-label="✕">✕</a><% } else { %><span class="hint"><%= sp ? spName + ' · ' : '' %><%= sort === 'hot' ? t('최근 30일 반응 많은 순') : sort === 'follow' ? t('팔로우한 회원의 새 사진') : t('새로 올라온 순') %></span><% } %>
  <span class="sp"></span>
  <a class="<%= sort === 'new' ? 'on' : '' %>" href="<%= sq({ sort: 'new' }) %>"><%= t('최신') %></a>
  <a class="<%= sort === 'hot' ? 'on' : '' %>" href="<%= sq({ sort: 'hot' }) %>"><%= t('인기') %></a>
  <a class="<%= sort === 'follow' ? 'on' : '' %>" href="<%= sq({ sort: 'follow' }) %>"><%= t('팔로우') %></a>
</div>

<% if (!list.length && sort === 'follow') { %>
  <div class="empty-st"><i>👤</i><% if (!followN) { %><%= t('팔로우한 회원이 없습니다.') %><br><%= t('관심 있는 회원의 온실에서 「＋ 팔로우」를 눌러 주세요.') %><% } else { %><%= t('팔로우한 회원의 새 사진이 없습니다.') %><% } %>
    <div style="margin-top:16px"><a class="btn line s" href="<%= B %>/"><%= t('전체 사진 보기') %></a></div></div>
<% } else if (!list.length) { %>
  <div class="empty-st"><i>🪴</i><%= t('아직 등록된 사진이 없습니다.') %><br><%= t('키우는 하월시아를 #품종명 과 함께 올려 주세요.') %>
    <div style="margin-top:16px"><a class="btn gold s" href="<%= B %>/write<%= tk ? '?tag=' + encodeURIComponent(tk) : '' %>">＋ <%= t('사진 등록') %></a></div></div>
<% } %>
<div class="masonry" id="feedlist"><% list.forEach(function (c) { %><%- include('_pin', { c: c }) %><% }); %></div>
<% if (more) { %><button class="btn line moreb" data-more="<%= next %>" data-target="feedlist"><%= t('더 보기') %></button><% } %>
<%- include('_foot', { tab: sort === 'hot' ? 'hot' : 'feed' }) %>
